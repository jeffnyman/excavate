<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>A DOS PC emulator core, built to play a chosen set of DOS games rather than to be a whole PC: an x86 CPU, VGA, the timer and interrupt hardware, FM, MT-32 and Sound Blaster sound, and DOS answered directly in C#, with no user interface of its own.</Description>
    <!-- optimized in Debug too: the CPU runs millions of instructions a second -->
    <Optimize>true</Optimize>
    <!-- every public member is documented: a missing comment fails the build -->
    <NoWarn>$(NoWarn.Replace('CS1591', ''))</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Excavate.Core.Tests" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>
</Project>
